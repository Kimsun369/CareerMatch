# CareerMatch — Deployment Configuration Template
# Copy this file to .deploy.env and fill in your values.
# NEVER commit .deploy.env to version control (protected by root .gitignore).

# 1. Neon PostgreSQL Connection String (format: postgresql://...sslmode=require)
DATABASE_URL=

# 2. Telegram Bot API Token from @BotFather (for @careermatch123bot)
TELEGRAM_BOT_TOKEN=

# 3. Render Backend Web Service URL (e.g. https://careermatch-backend.onrender.com)
RENDER_BACKEND_URL=

# 4. Vercel Frontend URL (e.g. https://careermatch.vercel.app)
VERCEL_FRONTEND_URL=

