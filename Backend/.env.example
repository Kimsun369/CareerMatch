# ─────────────────────────────────────────────────────────────
# CareerMatch Backend — environment configuration template
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────

# ── Django ────────────────────────────────────────────────────
# Generate a new secret key: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string

# Set to False in production
DJANGO_DEBUG=True

# Comma-separated list of allowed hosts
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ── Database ──────────────────────────────────────────────────
# Required for PostgreSQL. Format: postgres://USER:PASSWORD@HOST:PORT/DBNAME
# The values below match the local-dev PostgreSQL database setup instructions.
DATABASE_URL=postgres://careermatch:careermatch@localhost:5432/careermatch

# ── ReliefWeb API ─────────────────────────────────────────────
# A short slug identifying your project to ReliefWeb (any string works —
# ReliefWeb just asks that every consumer identify itself).
# Read more: https://apidoc.rwlabs.org/
RELIEFWEB_APPNAME=careermatch-fyp

# ── Telegram ──────────────────────────────────────────────────
# Required for REAL Telegram Mini App identity verification.
# Get this from @BotFather when you create your bot.
# If left blank, the app still runs fully in a browser using the
# built-in debug identity fallback (X-Debug-Telegram-Id header).
TELEGRAM_BOT_TOKEN=

# ── AI (optional) ─────────────────────────────────────────────
# The recommendation engine works without this. Only needed if you
# want optional AI-assisted ranking/explanation via Groq free tier.
GROQ_API_KEY=

# ── CORS ─────────────────────────────────────────────────────
# Origins the browser may call the API from (comma-separated).
# Covers common Vite/Next.js dev ports. Add your frontend port if different.
CORS_ALLOWED_ORIGINS=http://localhost:8443,http://127.0.0.1:8443,http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
